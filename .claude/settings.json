{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/user/Mutluet && [ -f scripts/setup-env.sh ] && bash scripts/setup-env.sh || echo 'Setup scripti bulunamadı, devam ediliyor'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm prisma*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm run*)",
      "Bash(npx prisma*)",
      "Bash(npx tsc*)",
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(npx @modelcontextprotocol*)",
      "Bash(curl -s*)",
      "Bash(bash scripts/*)"
    ]
  }
}
