# MutluET Monorepo — Environment Variables

# ─── Supabase (tüm uygulamalar) ───
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── Stripe ───
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── AI ───
OPENAI_API_KEY=sk-...

# ─── E-posta (Resend) ───
RESEND_API_KEY=re_...

# ─── Harita (Mapbox) ───
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Legacy API Configuration
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001

# WordPress Integration
VITE_WORDPRESS_URL=https://mutluet.org

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OAuth Configuration (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
VITE_TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
VITE_AZURE_AD_CLIENT_ID=your_azure_ad_client_id_here

# Google Maps API (Optional)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Sentry (Optional - for error tracking)
VITE_SENTRY_DSN=your_sentry_dsn_here

# Environment
VITE_ENV=development
