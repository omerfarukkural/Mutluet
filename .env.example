# Frontend Environment Variables

# ─── API ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001

# ─── WordPress ────────────────────────────────────────────────────────────────
VITE_WORDPRESS_URL=https://mutluet.org

# ─── Supabase (isteğe bağlı) ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── OAuth (isteğe bağlı) ─────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
VITE_TIKTOK_CLIENT_KEY=your_tiktok_client_key_here

# ─── Harita (Google Maps Education / isteğe bağlı) ───────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Video Görüşme (Jitsi Meet — ücretsiz, hesap gerekmez) ──────────────────
# Varsayılan: meet.jit.si (ücretsiz). Kendi sunucun için değiştir.
VITE_JITSI_DOMAIN=meet.jit.si

# ─── Hata Takibi (Sentry — ücretsiz 5K hata/ay) ─────────────────────────────
# https://sentry.io → Yeni Proje → React
VITE_SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ─── Ortam ────────────────────────────────────────────────────────────────────
VITE_ENV=development
