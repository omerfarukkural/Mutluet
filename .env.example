# =============================================================================
# MUTLUET / BİTEBİMUV — BOOTSTRAP .env ŞABLONU
#
# KULLANIM:
#   1. Bu dosyayı `.env` olarak kopyala:  cp .env.example .env
#   2. __FILL__ ile işaretli değerleri doldur
#   3. ./scripts/bootstrap.sh ile secret'ları vault'a taşı
#   4. Üretim ortamına bu dosyayı KOPYALAMA — vault'tan otomatik akar
#
# DETAY: AI_AJAN_FABRIKASI.md dosyasına bakın
# =============================================================================

# =============================================================================
# CORE
# =============================================================================
ENV=development
PROJECT=mutluet-factory
REGION_PRIMARY=westeurope

# =============================================================================
# FRONTEND (Vite)
# =============================================================================
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001
VITE_ENV=development

# WordPress Integration
VITE_WORDPRESS_URL=https://mutluet.org

# Supabase (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=__FILL__

# OAuth (Optional)
VITE_GOOGLE_CLIENT_ID=__FILL__
VITE_FACEBOOK_APP_ID=__FILL__
VITE_TIKTOK_CLIENT_KEY=__FILL__
VITE_AZURE_AD_CLIENT_ID=__FILL__

# Google Maps API (Optional)
VITE_GOOGLE_MAPS_API_KEY=__FILL__

# Sentry (Optional)
VITE_SENTRY_DSN=__FILL__

# =============================================================================
# GIT / CI
# =============================================================================
GITHUB_PAT=__FILL__
GITHUB_OAUTH_CLIENT_ID=__FILL__
GITHUB_OAUTH_CLIENT_SECRET=__FILL__

# =============================================================================
# AI PROVIDERS
# =============================================================================
OPENAI_API_KEY=__FILL__
ANTHROPIC_API_KEY=__FILL__
GEMINI_API_KEY=__FILL__
PERPLEXITY_API_KEY=__FILL__

# =============================================================================
# AZURE
# =============================================================================
AZURE_TENANT_ID=__FILL__
AZURE_SUBSCRIPTION_ID=__FILL__
AZURE_CLIENT_ID=__FILL__
AZURE_CLIENT_SECRET=__FILL__
AZURE_KEY_VAULT_URI=__FILL__
AZURE_COMMUNICATION_CONNECTION_STRING=__FILL__

# =============================================================================
# GOOGLE CLOUD
# =============================================================================
GCP_PROJECT_ID=__FILL__
GCP_WORKLOAD_IDENTITY_PROVIDER=__FILL__
GCP_SERVICE_ACCOUNT_EMAIL=__FILL__

# =============================================================================
# MONGODB ATLAS
# =============================================================================
MONGODB_ATLAS_PUBLIC_KEY=__FILL__
MONGODB_ATLAS_PRIVATE_KEY=__FILL__
MONGODB_ATLAS_ORG_ID=__FILL__
MONGODB_ATLAS_PROJECT_ID=__FILL__

# =============================================================================
# WORDPRESS (bitebimuv.org / mutluet.org)
# =============================================================================
WP_MUTLUET_URL=https://mutluet.org
WP_BITEBIMUV_URL=https://bitebimuv.org
WP_API_USERNAME=__FILL__
WP_APP_PASSWORD=__FILL__

# =============================================================================
# PAYMENTS / EMAIL / MEDIA / OBSERVABILITY
# =============================================================================
STRIPE_SECRET_KEY=__FILL__
STRIPE_WEBHOOK_SECRET=__FILL__
SENDGRID_API_KEY=__FILL__
CLOUDINARY_CLOUD_NAME=__FILL__
CLOUDINARY_API_KEY=__FILL__
CLOUDINARY_API_SECRET=__FILL__
SENTRY_DSN=__FILL__
