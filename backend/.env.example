# Backend Environment Variables

# ─── Veritabanı ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mutluet

# ─── Kimlik Doğrulama ─────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# WordPress SSO
WORDPRESS_JWT_SECRET=your_wordpress_sso_secret_key_change_this
WORDPRESS_URL=https://mutluet.org

# ─── Sunucu ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Email (Nodemailer + Gmail SMTP) ──────────────────────────────────────────
# Gmail için: Google Hesap > Güvenlik > 2FA aç > Uygulama Şifreleri
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=noreply@mutluet.org

# ─── Ödeme (Stripe — ücretsiz test modu) ────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ─── Dosya Depolama (Cloudinary — ücretsiz 25 GB) ───────────────────────────
# https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Hata Takibi (Sentry — ücretsiz 5K hata/ay) ─────────────────────────────
# https://sentry.io → Yeni Proje → Node.js
SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ─── AI Asistan (isteğe bağlı) ───────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here
