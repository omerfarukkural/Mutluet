# Backend Environment Variables

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mutluet

# JWT Secret (REQUIRED - Generate a secure random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email Service (Optional - SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@mutluet.org

# Payment Gateway (Optional - Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Cloud Storage (Optional - Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Azure Communication Services (Optional - SMS)
AZURE_COMMUNICATION_CONNECTION_STRING=your_azure_communication_connection_string

# Sentry (Optional - Error Tracking)
SENTRY_DSN=your_sentry_dsn_here
