# =============================================================================
# MUTLUET / BİTEBİMUV AI AJAN FABRİKASI — BOOTSTRAP .ENV ŞABLONU
# =============================================================================
# Bu dosya YALNIZCA ilk kurulumda kullanılır.
# Gerçek değerleri doldurduktan sonra Azure Key Vault'a aktarın:
#   ./scripts/bootstrap-secrets.sh .env.factory
#
# Runtime'da pod'lar bu dosyayı GÖRMEZ.
# External Secrets Operator, Azure Key Vault → Kubernetes Secret akışını yönetir.
#
# UYARI: Bu dosyayı ASLA Git'e commit etmeyin!
# .gitignore dosyasında .env.factory satırının bulunduğundan emin olun.
# =============================================================================

# ── TEMEL ────────────────────────────────────────────────────────────────────
ENV=prod
PROJECT=bitebimuv-factory
REGION_PRIMARY=eu-west-1

# ── GIT / CI ─────────────────────────────────────────────────────────────────
# GitHub Personal Access Token (repo, workflow, packages kapsamları gerekli)
GITHUB_PAT=__FILL__

# GitHub OAuth App (isteğe bağlı — ajan fabrikası için)
GITHUB_OAUTH_CLIENT_ID=__FILL__
GITHUB_OAUTH_CLIENT_SECRET=__FILL__

# ── AI SAĞLAYICILAR ──────────────────────────────────────────────────────────
# En az birini doldurun; ajan fabrikası önce ANTHROPIC_API_KEY'i dener
OPENAI_API_KEY=__FILL__
ANTHROPIC_API_KEY=__FILL__
GEMINI_API_KEY=__FILL__
PERPLEXITY_API_KEY=__FILL__

# ── AZURE ────────────────────────────────────────────────────────────────────
# Azure Portal > Azure Active Directory > App registrations
AZURE_TENANT_ID=__FILL__
AZURE_SUBSCRIPTION_ID=__FILL__
AZURE_CLIENT_ID=__FILL__
AZURE_CLIENT_SECRET=__FILL__

# Azure Key Vault URI
# Örnek: https://mutluet-vault.vault.azure.net/
AZURE_KEY_VAULT_URI=__FILL__

# Azure Communication Services (video görüşme)
AZURE_COMMUNICATION_CONNECTION_STRING=__FILL__

# ── GOOGLE CLOUD ─────────────────────────────────────────────────────────────
# GCP Console > IAM & Admin > Service Accounts
GCP_PROJECT_ID=__FILL__
GCP_WORKLOAD_IDENTITY_PROVIDER=__FILL__
GCP_SERVICE_ACCOUNT_EMAIL=__FILL__

# ── MONGODB ATLAS ────────────────────────────────────────────────────────────
# Atlas > Organization Settings > API Keys
MONGODB_ATLAS_PUBLIC_KEY=__FILL__
MONGODB_ATLAS_PRIVATE_KEY=__FILL__
MONGODB_ATLAS_ORG_ID=__FILL__
MONGODB_ATLAS_PROJECT_ID=__FILL__

# ── VERİTABANI ───────────────────────────────────────────────────────────────
# PostgreSQL bağlantı URL'si (Supabase veya Azure Database for PostgreSQL)
DATABASE_URL=__FILL__

# JWT ve güvenlik
JWT_SECRET=__FILL__
WORDPRESS_JWT_SECRET=__FILL__

# ── WORDPRESS (bitebimuv.org / mutluet.org) ──────────────────────────────────
WP_MUTLUET_URL=https://mutluet.org
WP_BITEBIMUV_URL=https://bitebimuv.org

# WordPress Application Password (revoke edilebilir, ana şifreyi paylaşmaz)
# WP Admin > Users > Application Passwords
WP_API_USERNAME=__FILL__
WP_APP_PASSWORD=__FILL__

# ── ÖDEME / E-POSTA / MEDYA / GÖZEMLEMLEBİLİRLİK ────────────────────────────
# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=__FILL__
STRIPE_PUBLISHABLE_KEY=__FILL__
STRIPE_WEBHOOK_SECRET=__FILL__

# SendGrid (https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=__FILL__

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=__FILL__
CLOUDINARY_API_KEY=__FILL__
CLOUDINARY_API_SECRET=__FILL__

# Sentry (https://sentry.io/settings/)
SENTRY_DSN=__FILL__

# ── OAUTH SAĞLAYICILAR ───────────────────────────────────────────────────────
# Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=__FILL__
GOOGLE_CLIENT_SECRET=__FILL__

# Facebook (https://developers.facebook.com/apps)
FACEBOOK_APP_ID=__FILL__
FACEBOOK_APP_SECRET=__FILL__

# ── MACOS PAKETLEME (Tauri) ──────────────────────────────────────────────────
# Apple Developer hesabı gerektirir
# https://tauri.app/distribute/sign/macos/
APPLE_SIGNING_IDENTITY=__FILL__
APPLE_CERTIFICATE=__FILL__
APPLE_CERTIFICATE_PASSWORD=__FILL__
APPLE_ID=__FILL__
APPLE_PASSWORD=__FILL__  # App-specific password (appleid.apple.com)
APPLE_TEAM_ID=__FILL__

# =============================================================================
# PLATFORM LİNKLERİ (Değer almak için bu sayfalara gidin)
# =============================================================================
# Azure Portal:              https://portal.azure.com
# Azure Key Vault:           https://portal.azure.com/#blade/HubsExtension/BrowseResource/resourceType/Microsoft.KeyVault%2Fvaults
# Google Cloud Console:      https://console.cloud.google.com
# MongoDB Atlas:             https://cloud.mongodb.com
# Stripe Dashboard:          https://dashboard.stripe.com
# SendGrid:                  https://app.sendgrid.com
# Cloudinary:                https://console.cloudinary.com
# Sentry:                    https://sentry.io
# Apple Developer:           https://developer.apple.com/account
# =============================================================================
